# ==========================================
# 🔑 MANUAL FILLS (API KEYS & PERSONALIZATION)
# ==========================================
GeminiAPIKey = your_gemini_api_key_here
GroqAPIKey = your_groq_api_key_here
HuggingFaceAPIKey = your_huggingface_api_key_here
CohereAPIKey = your_cohere_api_key_here

Username = Your Name
CreatorName = Your Name
Assistantname = Lucy

# ==========================================
# ⚙️ CONFIGURATION SETTINGS
# ==========================================
Inputlanguage = en-IN
AssistantLanguage = English unless the user speaks Hindi or Hinglish
AssistantVoice = en-US-AvaMultilingualNeural
AssistantVoiceRate = +0%
AssistantVoicePitch = +0Hz
WakeWords = hey lucy, lucy
InterruptWords = stop, wait, cancel, nevermind, ruko, ruk jao, bas, hey lucy, lucy

# ==========================================
# 🤖 MODEL & TOKEN LIMITS
# ==========================================
GeminiModel = gemini-2.5-flash-lite
GroqModel = llama-3.3-70b-versatile
ChatHistoryLimit = 4
MaxResponseTokens = 180
RealtimeMaxResponseTokens = 450
ContentMaxResponseTokens = 900
FileContextMaxChars = 6000

# ==========================================
# 🖼️ SPEECH & IMAGE GENERATION SETTINGS
# ==========================================
LongSpeechCharLimit = 420
LongSpeechSentenceLimit = 3
ImageProvider = pollinations
ImageCount = 1
ImageTimeout = 35
ImageHeight = 512
ImageWidth = 512
ImageFastMode = True
